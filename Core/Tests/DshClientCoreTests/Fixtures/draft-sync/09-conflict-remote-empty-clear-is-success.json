{
  "id": "09-conflict-remote-empty-clear-is-success",
  "note": "§13.2-6① + §13.2-8：清空写撞冲突而远端确为空 → 视为成功；清空带 cwd（曾写过工作区行）",
  "initial": {
    "mode": "remote",
    "isBlank": true,
    "cwd": "/x",
    "localText": ""
  },
  "events": [
    {
      "type": "enterSession"
    },
    {
      "type": "remoteRead",
      "text": "",
      "updatedAt": 0
    },
    {
      "type": "userEdited",
      "text": "x"
    },
    {
      "type": "debounceElapsed"
    },
    {
      "type": "writeSucceeded",
      "text": "x",
      "updatedAt": 120
    },
    {
      "type": "userCleared"
    },
    {
      "type": "writeFailed",
      "error": "conflict",
      "remote": {
        "text": "",
        "updatedAt": 0
      }
    },
    {
      "type": "remoteRead",
      "text": "",
      "updatedAt": 0
    }
  ],
  "expect": [
    {
      "type": "get",
      "cwd": "/x"
    },
    {
      "type": "none"
    },
    {
      "type": "none"
    },
    {
      "type": "set",
      "text": "x",
      "base": 0,
      "cwd": "/x"
    },
    {
      "type": "none"
    },
    {
      "type": "set",
      "text": "",
      "base": 120,
      "cwd": "/x"
    },
    {
      "type": "get",
      "cwd": "/x"
    },
    {
      "type": "none"
    }
  ],
  "expectState": {
    "base": 0,
    "localText": "",
    "dirty": false,
    "wroteWorkspaceRow": false
  }
}
