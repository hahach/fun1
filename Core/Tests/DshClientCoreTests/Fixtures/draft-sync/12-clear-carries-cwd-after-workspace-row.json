{
  "id": "12-clear-carries-cwd-after-workspace-row",
  "note": "§13.2-8 + §10.2-2：空白会话写过工作区行后，即便会话已转非 blank，清空仍带 cwd（owner 连带删）",
  "initial": {
    "mode": "remote",
    "isBlank": true,
    "cwd": "/x",
    "localText": ""
  },
  "events": [
    {
      "type": "enterSession"
    },
    {
      "type": "remoteRead",
      "text": "",
      "updatedAt": 0
    },
    {
      "type": "userEdited",
      "text": "d"
    },
    {
      "type": "debounceElapsed"
    },
    {
      "type": "writeSucceeded",
      "text": "d",
      "updatedAt": 100
    },
    {
      "type": "sessionBecameNonBlank"
    },
    {
      "type": "userCleared"
    }
  ],
  "expect": [
    {
      "type": "get",
      "cwd": "/x"
    },
    {
      "type": "none"
    },
    {
      "type": "none"
    },
    {
      "type": "set",
      "text": "d",
      "base": 0,
      "cwd": "/x"
    },
    {
      "type": "none"
    },
    {
      "type": "none"
    },
    {
      "type": "set",
      "text": "",
      "base": 100,
      "cwd": "/x"
    }
  ],
  "expectState": {
    "isBlank": false,
    "base": 100,
    "localText": "",
    "wroteWorkspaceRow": true
  }
}
