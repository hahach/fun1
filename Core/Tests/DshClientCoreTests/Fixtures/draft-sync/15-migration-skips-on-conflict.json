{
  "id": "15-migration-skips-on-conflict",
  "note": "§13.2-9：迁移撞 draft/conflict → 跳过，不算失败；远端更新且本机空时照常回填",
  "initial": {
    "mode": "remote",
    "isBlank": true,
    "cwd": "/x",
    "localText": "",
    "migratingText": "旧稿"
  },
  "events": [
    {
      "type": "enterSession"
    },
    {
      "type": "remoteRead",
      "text": "",
      "updatedAt": 0
    },
    {
      "type": "writeFailed",
      "error": "conflict",
      "remote": {
        "text": "新稿",
        "updatedAt": 700
      }
    },
    {
      "type": "remoteRead",
      "text": "新稿",
      "updatedAt": 700
    }
  ],
  "expect": [
    {
      "type": "get",
      "cwd": "/x"
    },
    {
      "type": "set",
      "text": "旧稿",
      "base": 0,
      "cwd": "/x"
    },
    {
      "type": "get",
      "cwd": "/x"
    },
    {
      "type": "backfill",
      "text": "新稿"
    }
  ],
  "expectState": {
    "base": 700,
    "localText": "新稿",
    "conflict": false,
    "suspended": false,
    "dirty": false
  }
}
