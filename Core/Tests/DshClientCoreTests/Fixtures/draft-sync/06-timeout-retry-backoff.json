    },
    {
      "type": "remoteRead",
      "text": "",
      "updatedAt": 0
    },
    {
      "type": "userEdited",
      "text": "t"
    },
    {
      "type": "debounceElapsed"
    },
    {
      "type": "writeTimedOut"
    },
    {
      "type": "retryElapsed"
    },
    {
      "type": "writeTimedOut"
    },
    {
      "type": "retryElapsed"
    },
    {
      "type": "writeTimedOut"
    },
    {
      "type": "retryElapsed"
    }
  ],
  "expect": [
