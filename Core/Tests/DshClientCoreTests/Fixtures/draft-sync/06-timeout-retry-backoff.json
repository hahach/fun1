      "base": 0,
      "cwd": "/x"
    },
    {
      "type": "scheduleRetry",
      "after": 10
    },
    {
      "type": "set",
      "text": "t",
      "base": 0,
      "cwd": "/x"
    },
    {
      "type": "none"
    },
    {
      "type": "none"
    }
  ],
  "expectState": {
    "pending": false,
    "dirty": true,
    "base": 0
  }
