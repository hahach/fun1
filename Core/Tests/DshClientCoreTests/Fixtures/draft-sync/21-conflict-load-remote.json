{
  "id": "21-conflict-load-remote",
  "note": "§13.3：冲突态下「载入远端」→ 远端文本填入输入框、base 取远端 updatedAt、解除挂起",
  "initial": {
    "mode": "remote",
    "isBlank": true,
    "cwd": "/x",
    "localText": ""
  },
  "events": [
    {
      "type": "enterSession"
    },
    {
      "type": "remoteRead",
      "text": "",
      "updatedAt": 0
    },
    {
      "type": "userEdited",
      "text": "mine"
    },
    {
      "type": "debounceElapsed"
    },
    {
      "type": "writeFailed",
      "error": "conflict",
      "remote": {
        "text": "theirs",
        "updatedAt": 400
      }
    },
    {
      "type": "remoteRead",
      "text": "theirs",
      "updatedAt": 400
    },
    {
      "type": "userAskedRemote"
    },
    {
      "type": "debounceElapsed"
    }
  ],
  "expect": [
    {
      "type": "get",
      "cwd": "/x"
    },
    {
      "type": "none"
    },
    {
      "type": "none"
    },
    {
      "type": "set",
      "text": "mine",
      "base": 0,
      "cwd": "/x"
    },
    {
      "type": "get",
      "cwd": "/x"
    },
    {
      "type": "showConflict",
      "remote": {
        "text": "theirs",
        "updatedAt": 400
      }
    },
    {
      "type": "backfill",
      "text": "theirs"
    },
    {
      "type": "clearConflict"
    },
    {
      "type": "none"
    }
  ],
  "expectState": {
    "localText": "theirs",
    "base": 400,
    "conflict": false,
    "suspended": false,
    "dirty": false
  }
}
