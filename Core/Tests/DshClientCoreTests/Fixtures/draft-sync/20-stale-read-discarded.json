{
  "id": "20-stale-read-discarded",
  "note": "§11.2-6：draft/get 发出后发生过入队写 → 该结果丢弃，不回填、不登记 base",
  "initial": {
    "mode": "remote",
    "isBlank": true,
    "cwd": "/x",
    "localText": ""
  },
  "events": [
    {
      "type": "enterSession"
    },
    {
      "type": "remoteRead",
      "text": "",
      "updatedAt": 0
    },
    {
      "type": "userEdited",
      "text": "a"
    },
    {
      "type": "debounceElapsed"
    },
    {
      "type": "writeSucceeded",
      "text": "a",
      "updatedAt": 100
    },
    {
      "type": "refresh"
    },
    {
      "type": "userEdited",
      "text": "ab"
    },
    {
      "type": "debounceElapsed"
    },
    {
      "type": "remoteRead",
      "text": "a",
      "updatedAt": 100
    }
  ],
  "expect": [
    {
      "type": "get",
      "cwd": "/x"
    },
    {
      "type": "none"
    },
    {
      "type": "none"
    },
    {
      "type": "set",
      "text": "a",
      "base": 0,
      "cwd": "/x"
    },
    {
      "type": "none"
    },
    {
      "type": "get",
      "cwd": "/x"
    },
    {
      "type": "none"
    },
    {
      "type": "set",
      "text": "ab",
      "base": 100,
      "cwd": "/x"
    },
    {
      "type": "none"
    }
  ],
  "expectState": {
    "base": 100,
    "localText": "ab",
    "dirty": true
  }
}
