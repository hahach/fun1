    {
      "type": "enterSession"
    },
    {
      "type": "remoteRead",
      "text": "",
      "updatedAt": 0
    },
    {
      "type": "userEdited",
      "text": "abc"
    },
    {
      "type": "debounceElapsed"
    },
    {
      "type": "writeFailed",
      "error": "conflict",
      "remote": {
        "text": "abc",
