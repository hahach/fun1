{
  "id": "13-clear-without-cwd-in-nonblank-session",
  "note": "§13.2-8 + §9.2-1：非 blank 会话不带 cwd；从未写过工作区行 → 清空也不带",
  "initial": {
    "mode": "remote",
    "isBlank": false,
    "cwd": "/x",
    "localText": ""
  },
  "events": [
    {
      "type": "enterSession"
    },
    {
      "type": "remoteRead",
      "text": "",
      "updatedAt": 0
    },
    {
      "type": "userEdited",
      "text": "d"
    },
    {
      "type": "debounceElapsed"
    },
    {
      "type": "writeSucceeded",
      "text": "d",
      "updatedAt": 100
    },
    {
      "type": "userCleared"
    }
  ],
  "expect": [
    {
      "type": "get"
    },
    {
      "type": "none"
    },
    {
      "type": "none"
    },
    {
      "type": "set",
      "text": "d",
      "base": 0,
      "cwd": null
    },
    {
      "type": "none"
    },
    {
      "type": "set",
      "text": "",
      "base": 100,
      "cwd": null
    }
  ],
  "expectState": {
    "isBlank": false,
    "base": 100,
    "wroteWorkspaceRow": false,
    "localText": ""
  }
}
